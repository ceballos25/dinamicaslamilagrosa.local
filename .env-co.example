# Copiar a ../.env-co (fuera del docroot) o a .env-co en la raíz del proyecto.
# En producción: DEBUG_MODE=false, DISPLAY_ERRORS=false, SESSION_COOKIE_SECURE=true

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=combostickers
DB_CHARSET=utf8mb4

# Sitio
SITE_NAME=Combo Stickers
SITE_URL=https://combostickers.com/

# Sesión
SESSION_AUTO_START=true
SESSION_NAME=CS
SESSION_LIFETIME=28800
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax

# Zona horaria
TIMEZONE=America/Bogota

# Modo
APP_ENV=production
DEBUG_MODE=false
DISPLAY_ERRORS=false

# Correo (opcional)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=ssl
MAIL_FROM=
MAIL_FROM_NAME=Combo Stickers
MAIL_BCC=

# Meta Pixel + Conversions API
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_CAPI_ENABLED=true
META_API_VERSION=v23.0
#META_TEST_EVENT_CODE=

# OCR comprobantes (OCR.space en hosting compartido)
COMPROBANTE_OCR_SPACE_API_KEY=

# Prefijo consecutivo ventas
SALE_PREFIX=CS
SALE_PAD=6
