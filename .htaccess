<IfModule mod_headers.c>
    # Sin CORS abierto: el panel y AJAX son mismo origen.
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), notifications=(self)"
</IfModule>

# ======================================================================
# BLOQUEO CRÍTICO — OpenLiteSpeed / CyberPanel / Apache
# ======================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Favicon en raíz (petición automática del navegador)
    RewriteRule ^favicon\.ico$ favicon.php [L]
    RewriteRule ^manifest-admin\.webmanifest$ - [L]

    # .env en raíz o subcarpetas
    RewriteRule (?:^|/)\.env - [F,L,NC]

    # Git y control de versiones
    RewriteRule (?:^|/)\.git - [F,L,NC]
    RewriteRule (?:^|/)\.(gitignore|gitattributes|htaccess) - [F,L,NC]

    # Backups
    RewriteRule (?:^|/).*\.(bak|old|save|swp|tmp)$ - [F,L,NC]

    # Carpetas sensibles
    RewriteRule ^logs/ - [F,L,NC]
    RewriteRule ^storage/ - [F,L,NC]
    RewriteRule ^vendor/ - [F,L,NC]
    RewriteRule ^config/ - [F,L,NC]
    RewriteRule ^database/ - [F,L,NC]
    RewriteRule ^bootstrap/ - [F,L,NC]
    RewriteRule ^src/ - [F,L,NC]
    RewriteRule ^tests/ - [F,L,NC]

    # Comprobantes de pago: solo acceso interno vía PHP
    RewriteRule ^uploads/comprobantes/ - [F,L,NC]
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/webp .webp
    AddType video/mp4 .mp4
</IfModule>

# Compresión y caché de estáticos (landing más rápida en móvil / 4G)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType video/mp4 "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|jpg|jpeg|png|gif|svg|woff2|mp4)$">
        Header set Cache-Control "public, max-age=604800, immutable"
    </FilesMatch>
</IfModule>

# Capa extra por nombre de archivo (compatibilidad Apache/OLS)
<FilesMatch "^(\.env|composer\.(json|lock)|package(-lock)?\.json)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<Files 403.shtml>
    Order allow,deny
    Allow from all
</Files>
